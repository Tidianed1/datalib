load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The summary page the file-tree and photo-library sources render to
# (fsindex, media, lightroom, apple_photos): its layout, its grid row,
# and the pinned read each provider's parse runs in. A provider's
# render crate contributes the queries and the numbers.
rust_library(
    name = "datalib_etl_summary_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_summary_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "summary_render_unittests",
    size = "small",
    crate = ":datalib_etl_summary_render",
    edition = "2021",
)
