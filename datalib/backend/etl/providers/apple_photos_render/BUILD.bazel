load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

# Render half of the `apple_photos` provider: the side that knows
# `datalib_schema`. //datalib/backend/etl/providers/apple_photos is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_apple_photos_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_apple_photos_render",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/apple_photos_config:datalib_etl_apple_photos_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl/summary_render:datalib_etl_summary_render",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
    ],
)

rust_test(
    name = "apple_photos_render_unittests",
    size = "small",
    crate = ":datalib_etl_apple_photos_render",
    edition = "2021",
)

# Mirror the TNG library, render it, and pin the page.
rust_test(
    name = "apple_photos_render_e2e",
    size = "small",
    srcs = ["tests/render_e2e.rs"],
    data = glob(["tests/snapshots/*.snap"], allow_empty = True) + [
        "//datalib/backend/etl/providers/apple_photos:tng_library",
    ],
    edition = "2021",
    env = {
        "APPLE_PHOTOS_TNG_DB": "$(rootpath //datalib/backend/etl/providers/apple_photos:tng_library)",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    deps = [
        ":datalib_etl_apple_photos_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/apple_photos:datalib_etl_apple_photos",
        "//datalib/backend/etl/providers/apple_photos_config:datalib_etl_apple_photos_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "apple_photos_render_e2e.update",
    extra_data = ["//datalib/backend/etl/providers/apple_photos:tng_library"],
    extra_env = {
        "APPLE_PHOTOS_TNG_DB": "$(rootpath //datalib/backend/etl/providers/apple_photos:tng_library)",
    },
    test = ":apple_photos_render_e2e",
)
