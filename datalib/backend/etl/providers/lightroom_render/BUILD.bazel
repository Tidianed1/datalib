load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

# Render half of the `lightroom` provider: the side that knows
# `datalib_schema`. //datalib/backend/etl/providers/lightroom is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_lightroom_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_lightroom_render",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl/summary_render:datalib_etl_summary_render",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
    ],
)

rust_test(
    name = "lightroom_render_unittests",
    size = "small",
    crate = ":datalib_etl_lightroom_render",
    edition = "2021",
)

# Mirror the TNG catalog, render it, and pin the page.
rust_test(
    name = "lightroom_render_e2e",
    size = "small",
    srcs = ["tests/render_e2e.rs"],
    data = glob(["tests/snapshots/*.snap"], allow_empty = True) + [
        "//datalib/backend/etl/sqlite_mirror:tng_catalog",
    ],
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
        "LIGHTROOM_TNG_CATALOG": "$(rootpath //datalib/backend/etl/sqlite_mirror:tng_catalog)",
    },
    deps = [
        ":datalib_etl_lightroom_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/lightroom:datalib_etl_lightroom",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "lightroom_render_e2e.update",
    extra_data = ["//datalib/backend/etl/sqlite_mirror:tng_catalog"],
    extra_env = {
        "LIGHTROOM_TNG_CATALOG": "$(rootpath //datalib/backend/etl/sqlite_mirror:tng_catalog)",
    },
    test = ":lightroom_render_e2e",
)
